# Logs del lanzador de desarrollo (scripts/dev.mjs)
/_dev.log
/_dev.err

# Capturas de los verificadores. Los verificadores en si SI se versionan
# (verify-page, verify-finanzas, verify-dark, verify-mercados): son
# herramientas reutilizables.
scripts/_verify/
/output/auditoria-codigo/

# Trabajo desechable de una sesion: guiones de parcheo puntual, volcados y
# pruebas sueltas. Se dejo esta carpeta al limpiar la raiz, que habia acumulado
# 23 archivos de ese tipo. Si algo de ahi hace falta de verdad, sacalo y
# versionalo con nombre y comentario; si no, se puede borrar entera.
/_scratch/

# Los guiones temporales de los verificadores se nombran asi para no colarse.
scripts/_tmp-*

# Logs locales del backend
backend/server-current.log
backend/server-current-error.log
backend/server-*-out.log
backend/server-*-err.log

# Ajustes locales de la boveda de Obsidian (el contenido de notas SI se versiona
# si se decide versionarlo; esto es solo la configuracion del editor).
#
# NOTA: estas ultimas lineas estaban escritas en UTF-16 y con bytes NUL, asi que
# git trataba el .gitignore entero como BINARIO y dejaba de aplicar las reglas.
# Es la trampa de Add-Content/Out-File en PowerShell. Reescrito en UTF-8.
boveda_obsidian/.obsidian/
/.npm-security-cache/
/backend/data/orion-forecast/

# Configuración privada de despliegue y resultados locales de verificaciones
/.vercel/
/frontend/artifacts/
/output/*/
!/output/pdf/
/output/pdf/orion-regresion-lineal-sp500-vista-previa.pdf
/output/pdf/vallnews-pdf-personalizado-muestra.pdf

# Resultados locales, respaldos y documentos generados: no forman parte del código.
/output/
/docs/referencias/
/docs/*.docx
**/~$*

# Cubrir variantes locales de configuración sin ocultar las plantillas vacías.
**/.env*
!**/.env.example

# Diagnósticos locales, no forman parte del código publicado.
/scratch/
