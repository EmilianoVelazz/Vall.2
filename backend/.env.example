# Copia este archivo a .env y llena los valores reales.
# En Vercel, configura estas variables en Settings > Environment Variables.

# ── Obligatorias: sin ellas el servidor NO arranca ───────────────────────────
JWT_SECRET=
REFRESH_SECRET=

USER_EMAIL=admin@vall.com
USER_PASSWORD=

# ── Base de datos (MariaDB/MySQL) ────────────────────────────────────────────
# Faltaban en este archivo. Sin ellas la capa de IA/RAG no conecta y FALLA EN
# SILENCIO: rag-retriever devuelve [] y se autodesactiva 60 s, así que el chat
# responde sin evidencia y nada avisa de que la base no está.
#
# Cada una admite además un alias MYSQL_* (y el nombre acepta DB_DATABASE).
# Si se rellena el alias equivocado tampoco hay error: cae al siguiente y acaba
# en undefined. Usa estos nombres salvo que tengas un motivo.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Proveedores de datos ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# Conversación de voz nativa (Gemini Live). La clave sigue siendo solo backend.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Sulafat

# ── Supabase (persistencia privada del entrenamiento VALL-ML) ────────────────
# Usa la service-role key sólo en el backend/.env.local o en los secretos del
# despliegue. Nunca la declares con el prefijo VITE_ ni la expongas al navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa segura para el servidor cuando no se usa service role. Es una URL
# de pooler PostgreSQL y nunca debe llevar prefijo VITE_.
SUPABASE_DATABASE_URL=
# OJO: la misma clave de Alpha Vantage la comparten los precios de maíz y trigo
# (/api/commodity) y los titulares (/api/alphavantage-news), y el plan gratuito
# son 25 peticiones AL DÍA entre las dos cosas.
ALPHA_VANTAGE_KEY=
BANXICO_TOKEN=
FINNHUB_TOKEN=
NEWSAPI_KEY=
# Proteínas: habilitan fuentes oficiales complementarias. No se exponen al navegador.
# INEGI y USDA NASS requieren registro; BLS funciona sin clave dentro de su cuota pública.
INEGI_TOKEN=
USDA_NASS_KEY=
USDA_AMS_KEY=
BLS_API_KEY=
# Fuente pecuaria de Corea del Sur: registrar una clave propia en MAFRA/data.go.kr.
# Un repositorio MCP de terceros puede usar esa plataforma, pero no sustituye la clave oficial.
MAFRA_API_KEY=
# Comercio exterior oficial reportado por las autoridades nacionales a ONU Comtrade.
UN_COMTRADE_API_KEY=
# Secreto exclusivo del cron de Vercel que actualiza los informes ejecutivos.
CRON_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# 5273 es el puerto de Vite de ESTE proyecto, no el 5173 de siempre: lo fija
# scripts/dev.mjs para no chocar con otros proyectos de la máquina.
# Agrega aquí la URL de tu despliegue.
ALLOWED_ORIGINS=http://localhost:3101,http://localhost:5273,https://valla.vercel.app

# ── Opcionales ───────────────────────────────────────────────────────────────
# SPA_ORIGIN: a dónde redirige el backend las rutas de la SPA en desarrollo.
# Lo pasa scripts/dev.mjs automáticamente; solo se pone a mano si arrancas
# backend/server.js por tu cuenta.
# SPA_ORIGIN=http://localhost:5273
#
# _TLS_STRICT: fuerza la verificación TLS completa en local. Por defecto se
# relaja en Windows porque faltan CAs intermedias de algunos proveedores.
# _TLS_STRICT=1
#
# PRODUCTION_URL: origen público del despliegue, si no lo aporta Vercel.
# PRODUCTION_URL=
#
# Workers de IA: desactivados por defecto. Habilítalos solo cuando exista una
# revisión humana para reglas y propuestas generadas.
VALL_ML_ENABLED=false
VALL_BRAIN_ENABLED=false
VALL_ML_TRAINING_ENABLED=false

# Pronósticos numéricos: se entrenan manualmente o desde un job después de
# cargar históricos. El modelo se niega a publicar si no supera al baseline.
# npm run train:forecast -- --symbol=USDMXN=X --interval=1d

# No añadas claves con prefijo VITE_: los proveedores se consultan exclusivamente
# desde Express para no exponer sus credenciales.
