# Copia este archivo a .env y llena los valores reales.
# En Vercel, configura estas variables en Settings > Environment Variables.

# ── Obligatorias: sin ellas el servidor NO arranca ───────────────────────────
JWT_SECRET=
REFRESH_SECRET=

USER_EMAIL=admin@vall.com
USER_PASSWORD=

# ── Base de datos (MariaDB/MySQL) ────────────────────────────────────────────
# Faltaban en este archivo. Sin ellas la capa de IA/RAG no conecta y FALLA EN
# SILENCIO: rag-retriever devuelve [] y se autodesactiva 60 s, así que el chat
# responde sin evidencia y nada avisa de que la base no está.
#
# Cada una admite además un alias MYSQL_* (y el nombre acepta DB_DATABASE).
# Si se rellena el alias equivocado tampoco hay error: cae al siguiente y acaba
# en undefined. Usa estos nombres salvo que tengas un motivo.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# MySQL remoto exige TLS verificado. Solo para una MariaDB en la red privada de
# Docker (p. ej. el servicio MariaDB de Dokploy), que no ofrece TLS:
# MYSQL_TLS=disable

# ── Proveedores de datos ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# Conversación de voz nativa (Gemini Live). La clave sigue siendo solo backend.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Sulafat
# Investigación web con Gemini: permite que VALL AI consulte y cite fuentes
# públicas para análisis históricos o por país. Gemini 3 cobra las búsquedas
# que el modelo decide ejecutar; ponlo en false para desactivarlas.
GEMINI_WEB_GROUNDING=true

# ── Supabase (persistencia privada de Proyecto Loopus) ──────────────────────
# Usa la service-role key sólo en el backend/.env.local o en los secretos del
# despliegue. Nunca la declares con el prefijo VITE_ ni la expongas al navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa segura para el servidor cuando no se usa service role. Es una URL
# de pooler PostgreSQL y nunca debe llevar prefijo VITE_.
SUPABASE_DATABASE_URL=
# Pooler explícito si se usa SUPABASE_PASSWORD (evita sondear regiones).
SUPABASE_POOLER_HOST=
# Certificado CA PEM adicional cuando el proveedor lo requiera; TLS siempre se verifica.
SUPABASE_DB_CA=
# MySQL remoto siempre usa TLS; CA adicional opcional. Loopback conserva el modo local.
MYSQL_DB_CA=
# OJO: la misma clave de Alpha Vantage la comparten los precios de maíz y trigo
# (/api/commodity) y los titulares (/api/alphavantage-news), y el plan gratuito
# son 25 peticiones AL DÍA entre las dos cosas.
ALPHA_VANTAGE_KEY=
BANXICO_TOKEN=
FINNHUB_TOKEN=
NEWSAPI_KEY=
# Proteínas: habilitan fuentes oficiales complementarias. No se exponen al navegador.
# INEGI y USDA NASS requieren registro; BLS funciona sin clave dentro de su cuota pública.
INEGI_TOKEN=
USDA_NASS_KEY=
USDA_AMS_KEY=
BLS_API_KEY=
# Fuente pecuaria de Corea del Sur: registrar una clave propia en MAFRA/data.go.kr.
# Un repositorio MCP de terceros puede usar esa plataforma, pero no sustituye la clave oficial.
MAFRA_API_KEY=
# Comercio exterior oficial reportado por las autoridades nacionales a ONU Comtrade.
UN_COMTRADE_API_KEY=
# Secreto exclusivo del cron de Vercel que actualiza los informes ejecutivos.
CRON_SECRET=

# ── Correo de informes ───────────────────────────────────────────────────────
# Remitente de Gmail y contraseña de aplicación. No es la contraseña habitual
# de la cuenta. Nunca uses prefijos VITE_ para estas variables.
# Reinicia npm run dev después de cambiarlas; npm run check:mail comprueba
# conexión y autenticación sin enviar mensajes.
GMAIL_USER=
GMAIL_PASS=
# Para diagnóstico local sin ejecutar la cola de correos: npm run dev:mail-check
# false desactiva todas las entradas de entrega programada en ese proceso.
# VALL_REPORT_EMAIL_AUTOMATION_ENABLED=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# 5273 es el puerto de Vite de ESTE proyecto, no el 5173 de siempre: lo fija
# scripts/dev.mjs para no chocar con otros proyectos de la máquina.
# Agrega aquí la URL de tu despliegue.
ALLOWED_ORIGINS=http://localhost:3101,http://localhost:5273,https://vallpruebas.vercel.app

# ── Opcionales ───────────────────────────────────────────────────────────────
# SPA_ORIGIN: a dónde redirige el backend las rutas de la SPA en desarrollo.
# Lo pasa scripts/dev.mjs automáticamente; solo se pone a mano si arrancas
# backend/server.js por tu cuenta.
# SPA_ORIGIN=http://localhost:5273
#
# _TLS_STRICT: valor de compatibilidad. La verificación TLS está siempre activa;
# se agregan las raíces de confianza de Node y del sistema cuando están disponibles.
# _TLS_STRICT=1
#
# PRODUCTION_URL: origen público del despliegue, si no lo aporta Vercel.
# PRODUCTION_URL=
#
# Carpeta privada y persistente para los archivos de ORION. En local se usa
# backend/generated-reports/chat/. En hosting usa un volumen persistente;
# /tmp de un entorno serverless no conserva los archivos entre instancias.
# VALL_REPORT_STORAGE_DIR=
# Historial de ediciones diarias públicas: backend/cache/report-history en local.
# En Dokploy apunta esta variable a un volumen persistente privado. En Vercel,
# el valor predeterminado /tmp/report-history es temporal entre instancias.
# VALL_REPORT_HISTORY_DIR=/data/vallnews/report-history
# Límites del archivo permanente (MB): local 512 por cuenta / 2048 total;
# serverless 64 por cuenta / 256 total. No se eliminan archivos al agotarlos.
# VALL_REPORT_MAX_OWNER_MB=512
# VALL_REPORT_MAX_TOTAL_MB=2048
#
# ── Docker / Dokploy ─────────────────────────────────────────────────────────
# La imagen (Dockerfile en la raíz) ejecuta `node backend/server.js` con
# NODE_ENV=production y Express sirve también dist/. Los temporizadores internos
# sustituyen a los crons de Vercel: usar UNA sola réplica o los correos
# programados se enviarían dos veces.
#
# Detrás del proxy de Dokploy (Traefik), un salto de confianza para que el
# límite de peticiones distinga a cada visitante:
# TRUST_PROXY=1
# PRODUCTION_URL=https://tu-dominio.com
# ALLOWED_ORIGINS=https://tu-dominio.com
#
# Volúmenes persistentes (montar en Dokploy):
#   /app/backend/cache              cachés, informes ejecutivos y programaciones
#   /app/backend/generated-reports  archivos de ORION y ediciones personales
#
# El scraper del SNIIM solo devuelve referencias estáticas; la imagen no incluye
# navegador. false evita intentar lanzarlo:
# VALL_SNIIM_BROWSER=false
#
# Migraciones de MariaDB (001-003) una vez desde la terminal del contenedor:
#   node scripts/migrate-database.cjs
# La 001 requiere DB_NAME=vall_. Las demás migraciones son de Supabase.
#
# Workers de IA: desactivados por defecto. Habilítalos solo cuando exista una
# revisión humana para reglas y propuestas generadas.
VALL_ML_ENABLED=false
VALL_BRAIN_ENABLED=false
VALL_ML_TRAINING_ENABLED=false

# Pronósticos numéricos: se entrenan manualmente o desde un job después de
# cargar históricos. El modelo se niega a publicar si no supera al baseline.
# npm run train:forecast -- --symbol=USDMXN=X --interval=1d

# Seguimiento ORION: local usa archivos privados persistentes; Vercel usa
# Supabase. No usar almacenamiento local sobre /tmp para seguimiento duradero.
# ORION_FORECAST_STORAGE=local
# Para una conexión IPv4, copia el host exacto desde Connect > Session pooler.
# SUPABASE_POOLER_HOST=
# SUPABASE_POOLER_PORT=5432
# Alternativamente configura SUPABASE_DATABASE_URL sólo en el servidor.
# ORION_FORECAST_DIRECTORY=C:/ruta/privada/persistente/orion-forecast
# En hosting: ORION_FORECAST_STORAGE=supabase y migraciones 014 y 015 aplicadas.
# npm run review:orion:forecasts evalúa pendientes sin emitir nuevas estimaciones.
# El mismo trabajo se ejecuta con los cortes de 06:00 y 14:00 CDMX.
# Correo: Vercel requiere cron por minuto compatible con el plan (o un
# programador externo autenticado); en local el backend debe permanecer activo.
# CRON_SECRET debe coincidir con el Bearer del programador y no usarse en VITE_.

# No añadas claves con prefijo VITE_: los proveedores se consultan exclusivamente
# desde Express para no exponer sus credenciales.
