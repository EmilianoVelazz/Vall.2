{
    "name": "vallnews",
    "private": true,
    "version": "2.0.0",
    "type": "commonjs",
    "scripts": {
        "prestart": "npm run build",
        "start": "node backend/server.js",
        "dev": "node scripts/dev.mjs",
        "dev:backend": "node backend/server.js",
        "dev:react": "node frontend/node_modules/vite/bin/vite.js",
        "build": "node scripts/build-dist.mjs",
        "build:map": "node scripts/build-world-map.mjs",
        "db:migrate": "node scripts/migrate-database.cjs",
        "ingest:data": "node scripts/ingest-intelligence.cjs",
        "train-ml": "node backend/ai/ml-training-loop.js",
        "train:forecast": "node scripts/train-forecast.cjs",
        "train:proteins": "node backend/ai/protein-training-loop.js",
        "sync:ml:supabase": "node scripts/sync-ml-cache-to-supabase.cjs",
        "sync:proteins:supabase": "node scripts/import-protein-research-direct.cjs",
        "db:migrate:finance-reports": "node scripts/apply-finance-reports-migration.cjs",
        "refresh:finance-reports": "node scripts/generate-finance-reports.cjs",
        "db:migrate:market-reports": "node scripts/apply-market-reports-migration.cjs",
        "refresh:market-reports": "node scripts/generate-market-reports.cjs",
        "test:ai": "node scripts/test-ai-response.cjs && node scripts/test-chat-contract.cjs && node scripts/test-historical-chart.cjs && node scripts/test-report-export.cjs && node scripts/test-market-review.cjs && node scripts/test-forecast.cjs",
        "verify:mercados": "node scripts/verify-mercados.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.5.2",
        "@google/genai": "^2.13.0",
        "@google/generative-ai": "^0.24.1",
        "@supabase/supabase-js": "^2.112.4",
        "bcryptjs": "^3.0.3",
        "chart.js": "^4.4.3",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "docx": "^8.5.0",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "lightweight-charts": "^4.2.2",
        "mermaid": "^11.16.0",
        "mysql2": "^3.23.1",
        "nodemailer": "^9.0.3",
        "normalize.css": "^8.0.1",
        "pdfkit": "^0.19.1",
        "pg": "^8.23.0",
        "playwright": "^1.62.1",
        "ssl-root-cas": "^1.3.1"
    },
    "devDependencies": {
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "puppeteer": "^25.4.0"
    }
}
